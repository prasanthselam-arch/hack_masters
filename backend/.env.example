# gemini (default) or openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-key
# OPENAI_API_KEY=sk-...

# Only needed behind a TLS-inspecting corporate proxy: system CA bundle + proxy root CA.
# CA_BUNDLE=/path/to/ca-bundle.pem

# Comma-separated fallback chains per role (first available model wins).
# GEMINI_EXTRACT_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.8-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite
# GEMINI_VERIFY_MODELS=gemini-3-flash-preview,gemini-3.5-flash,gemini-3.8-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite
# GEMINI_FAST_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-2.5-flash-lite
# OPENAI_EXTRACT_MODELS=gpt-5.4
# OPENAI_VERIFY_MODELS=gpt-5.4
# OPENAI_FAST_MODELS=gpt-5.4-mini
ENABLE_VERIFICATION=true

# Defaults to SQLite in backend/data. For Postgres:
# DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# Sign-in sessions. Set COOKIE_SECURE=true when the app is served over HTTPS.
# SESSION_DAYS=30
# COOKIE_SECURE=false

# Email codes and alerts through a Google Apps Script web app that sends from your Gmail (about 100 a day; see
# scripts/google-apps-script/Code.gs). Without a URL, a local http:// server shows codes on screen instead of
# emailing them; a server with COOKIE_SECURE=true refuses to send codes.
# GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/.../exec
# GOOGLE_SCRIPT_SECRET=the-same-value-as-the-script's-SECRET-property
# MAIL_FROM_NAME=Health Copilot
# APP_URL=http://localhost:5173
# CRON_SECRET=   # lets the daily GitHub Action run reminders and weekly summaries
